# --- Groww Trading API (pick ONE of the three ways) -------------------------
# 1) TOTP key (recommended: no daily manual approval)
GROWW_API_KEY=
GROWW_TOTP_SECRET=
# 2) API key + secret (needs daily approval on the Groww API keys page)
GROWW_API_SECRET=
# 3) A ready access token (expires daily)
GROWW_ACCESS_TOKEN=

# --- Telegram ---------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Sizing (optional; leave CAPITAL empty to omit lot sizing) --------------
CAPITAL=
RISK_PCT=0.5

# --- Overrides (optional; normally resolved from Groww's instrument list) ---
FUT_GROWW_SYMBOL=
FUT_TRADING_SYMBOL=
VIX_GROWW_SYMBOL=
VIX_TRADING_SYMBOL=
# auto | v2 | legacy
CANDLE_API=auto
